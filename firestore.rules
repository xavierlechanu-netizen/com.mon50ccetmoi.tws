rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- FONCTIONS DE SÉCURITÉ ---
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function getUsername() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.username;
    }

    // Anti-usurpation (audit 2026-11, E2) : si un champ d identite est fourni a la creation,
    // il doit designer l auteur reel. Les champs restent facultatifs pour ne rien casser.
    function ownsIdFields(data) {
      return (!("uid" in data) || data.uid == request.auth.uid)
        && (!("userId" in data) || data.userId == request.auth.uid)
        && (!("authorUid" in data) || data.authorUid == request.auth.uid)
        && (!("leaderUid" in data) || data.leaderUid == request.auth.uid);
    }

    function ownsUsernameField(data, field) {
      return !(field in data) || data[field] == getUsername();
    }

    function signedInOwnCreate() {
      return isSignedIn() && ownsIdFields(request.resource.data);
    }

    // Pseudos (audit 2026-11-07) : de nombreuses règles identifient l'auteur par son pseudo
    // (getUsername). Un pseudo doit donc être unique et ne plus changer après l'inscription.
    function validUsername(name) {
      return name is string && name.matches('^[A-Za-z0-9_.-]{3,30}$');
    }

    function usernameReservedBy(name, uid) {
      return getAfter(/databases/$(database)/documents/usernames/$(name.lower())).data.uid == uid;
    }

    // --- RÈGLES PAR COLLECTION ---

    // Profils Utilisateurs : Lecture strictement restreinte au propriétaire ou à l'administrateur (OWASP A01 / RGPD Art. 5)
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      
      // OWASP ASVS v5.0.0-8.x : Interdiction stricte de s'auto-attribuer le rôle admin, points, premium, garage certifié ou bypass de ban
      // Le pseudo doit être réservé dans /usernames par le même utilisateur (même lot d'écriture)
      allow create: if isSignedIn() && isOwner(userId)
        && (!('role' in request.resource.data) || request.resource.data.role == 'user')
        && (!('uid' in request.resource.data) || request.resource.data.uid == userId)
        && validUsername(request.resource.data.username)
        && usernameReservedBy(request.resource.data.username, request.auth.uid)
        && !request.resource.data.keys().hasAny([
          'blackbox_serial', 'braveCoins', 'bvc_points', 'bvcPoints', 'points',
          'isPremium', 'premiumPlan', 'premiumSince', 'subscription', 'blackboxCare',
          'isCertifiedGarage', 'isGaragePartner', 'certified_at',
          'isBanned', 'isTempBanned', 'banReason', 'banExpireAt', 'tempBansCount', 'appealStatus'
        ]);

      // Mise à jour : l'admin peut tout modifier ; le propriétaire ne peut JAMAIS modifier ses privilèges, points, statuts d'abonnement ou de sanction,
      // ni son pseudo ou son uid (sinon il hériterait des droits d'un autre membre portant ce pseudo)
      allow update: if isAdmin() || (
        isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'username', 'uid',
          'role', 'blackbox_serial', 'braveCoins', 'bvc_points', 'bvcPoints', 'points',
          'isPremium', 'premiumPlan', 'premiumSince', 'subscription', 'blackboxCare',
          'isCertifiedGarage', 'isGaragePartner', 'certified_at',
          'isBanned', 'isTempBanned', 'banReason', 'banExpireAt', 'tempBansCount', 'appealStatus',
          'lastPointsPurchase', 'compensationAwarded', 'banLiftedAt', 'banLiftedBy'
        ])
      );
      allow delete: if isAdmin();

      // FIDO2 Credentials (Écriture via Cloud Functions uniquement)
      match /fido_credentials/{credId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if false; 
      }

      // Quotas journaliers anti-triche (Écriture via Cloud Functions uniquement)
      match /daily_quotas/{dateKey} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if false;
      }
    }

    // Réservation des pseudos (identifiant = pseudo en minuscules). Une réservation n'est valable
    // que pour le pseudo inscrit dans le profil de son auteur : impossible d'en réserver d'autres.
    // Les comptes existants peuvent ainsi réserver leur propre pseudo (rattrapage à la connexion).
    match /usernames/{name} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['uid', 'username', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && validUsername(request.resource.data.username)
        && name == request.resource.data.username.lower()
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.username.lower() == name;
      allow update, delete: if false; // libération d'un pseudo : admin (Admin SDK) uniquement
    }

    // Certificats de Batterie : Lecture restreinte, émission exclusive Cloud Function (Admin SDK)
    match /battery_certificates/{certId} {
      allow read: if isSignedIn() && (isOwner(resource.data.userId) || resource.data.isShared == true);
      allow write: if false; // Émission inaltérable réservée au webhook Revolut
    }

    // Blackbox : Stockage ultra-privé. Création certifiée par le backend, lecture réservée au propriétaire ou expert vérifié
    match /blackbox_reports/{reportId} {
      allow create, update, delete: if false; // Création inaltérable certifiée réservée au serveur (Admin SDK)
      allow read: if isSignedIn() && (isOwner(resource.data.userId) || isAdmin() || (resource.data.isUnlocked == true));
    }

    // Blackbox Télémétrie : Zero-Knowledge Storage. Ingestion exclusive via Cloud Function uploadBlackboxTelemetry
    match /blackbox_telemetry/{userId}/frames/{frameId} {
      allow create, update, delete: if false; // IMMUABILITE ABSOLUE - Traité uniquement par Admin SDK
      allow read: if isSignedIn() && (isOwner(userId) || isAdmin());
    }

    // Coffre-fort ANTS : Sanctuaire absolu (validation de schéma renforcée)
    match /ants_wallet/{walletId} {
      allow read: if isOwner(walletId);
      allow create: if isOwner(walletId)
        && request.resource.data.keys().hasOnly(['permis', 'carte_grise', 'assurance', 'controle_technique', 'updated_at'])
        && request.resource.data.updated_at == request.time;
      allow update: if isOwner(walletId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['permis', 'carte_grise', 'assurance', 'controle_technique', 'updated_at'])
        && request.resource.data.updated_at == request.time;
      allow delete: if false; // Les documents ANTS ne doivent jamais être supprimés
    }

    // OBD-II Sessions (Historique des balades)
    match /obd_sessions/{sessionId} {
      allow create: if isSignedIn() && isOwner(request.resource.data.userId);
      allow read: if isSignedIn() && isOwner(resource.data.userId);
      allow update, delete: if false; // Immuable
    }

    // Gamification Stats (XP, Badges, Rangs)
    // Professionnels acheteurs de rapports, vérifiés par SIREN côté serveur (registerInsurerProfile)
    match /insurer_profiles/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if false;
    }

    // Factures à émettre dans Kolecto (préparées par le serveur après paiement)
    match /invoices_to_issue/{orderId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Classement public des pilotes : pseudo + points gagnés, tenu uniquement par le serveur
    match /leaderboard/{userId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /gamification_stats/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if false; // Anti-cheat strict : modifications XP uniquement via Cloud Functions
      allow delete: if false; // On ne supprime pas un profil de gamification
    }

    // Registre / Grand Livre des Points mon50cc (BVC Points / BraveCoins)
    // OWASP ASVS v5.0.0-2.3.3 : Grand livre immuable et auditable
    match /points_ledger/{ledgerId} {
      allow read: if isSignedIn() && (isOwner(resource.data.userId) || isAdmin());
      allow write: if false; // Strictement réservé aux Cloud Functions Admin SDK
    }

    // Guardian Angel Sessions : Partage à durée limitée, ou propriétaire vérifié
    match /guardian_sessions/{sessionId} {
      allow read: if isSignedIn() && (isOwner(resource.data.userId) || (resource.data.isShared == true && resource.data.expiresAt > request.time));
      allow create: if isSignedIn() && isOwner(request.resource.data.userId);
      allow update: if isSignedIn() && isOwner(resource.data.userId) && isOwner(request.resource.data.userId);
      allow delete: if isSignedIn() && isOwner(resource.data.userId);
    }

    // Radar Social (Partage de position GPS temps réel)
    match /social_radar/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isOwner(userId);
    }

    // Alertes Communautaires (Hazards & Danger Zones)
    match /hazards/{hazardId} {
      allow read: if isSignedIn();
      allow create: if signedInOwnCreate()
        && ownsUsernameField(request.resource.data, "author")
        // "Membre" = repli de danger-zones.js quand le pseudo est absent
        && (!("reporter" in request.resource.data) || request.resource.data.reporter == "Membre"
            || request.resource.data.reporter == getUsername());
      allow update: if isSignedIn() && (isOwner(resource.data.author) || isOwner(resource.data.reporter));
      allow delete: if isAdmin() || (isSignedIn() && (getUsername() == resource.data.author || getUsername() == resource.data.reporter));
    }

    // Sessions de Balades
    match /balades/{baladeId} {
      allow read: if isSignedIn() && (isOwner(resource.data.userId) || resource.data.isPublic == true);
      allow create: if isSignedIn() && isOwner(request.resource.data.userId);
      allow update, delete: if isOwner(resource.data.userId);
    }

    // Partage de position en temps réel (Presence)
    match /presence/{username} {
      allow read: if isSignedIn(); // Protection de la localisation
      allow write: if isSignedIn() && getUsername() == username;
    }

    // Humeurs / Ticker Social (Moods) — Lecture authentifiée uniquement (OWASP A01)
    match /moods/{moodId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && getUsername() == request.resource.data.username;
      allow delete: if isAdmin();
    }

    // SOS / Alertes d'urgence (Emergency Alerts)
    match /emergency_alerts/{alertId} {
      allow read: if isSignedIn(); // Protection des données sensibles d'accident
      allow create: if isSignedIn() && isOwner(request.resource.data.userId);
    }

    // Signalement d'abus (Reports Abuse)
    match /reports_abuse/{reportId} {
      allow read: if isAdmin();
      allow create: if signedInOwnCreate();
      allow update, delete: if isAdmin();
    }

    // Signalements de litiges assureurs (Insurer Reports)
    match /insurer_reports/{reportId} {
      allow read: if isAdmin();
      allow create: if signedInOwnCreate();
      allow update, delete: if isAdmin();
    }

    // Stations services signalées/blacklistées (Blacklist Stations)
    match /blacklist_stations/{stationId} {
      allow read: if isSignedIn(); // Sécurisé : empêche le scraping anonyme (OWASP A01)
      allow create: if signedInOwnCreate();
      allow update, delete: if isAdmin() || (isSignedIn() && isOwner(resource.data.userId));
    }

    // Dossiers de plaintes officiels (Complaints Official)
    match /complaints_official/{complaintId} {
      allow read: if isAdmin();
      allow create: if signedInOwnCreate();
      allow update, delete: if isAdmin() || (isSignedIn() && isOwner(resource.data.userId));
    }

    // Inscriptions Beta Testeurs
    match /beta_testers/{testerId} {
      allow read: if isOwner(testerId) || isAdmin(); 
      allow create: if signedInOwnCreate(); 
      allow update, delete: if isAdmin();
    }

    // Rapports d'erreurs (Crash Reports / Bugs)
    match /crash_reports/{reportId} {
      allow create: if signedInOwnCreate(); // Protection contre le DoS (OWASP A11)
      allow read, update, delete: if isAdmin();
    }

    // Alertes d'administration (Admin Alerts)
    match /admin_alerts/{alertId} {
      allow read: if isAdmin();
      allow create: if signedInOwnCreate();
      allow update, delete: if isAdmin();
    }

    // Évaluations des garages (Garage Evaluations)
    // Moyenne des garages : calculée et écrite uniquement par la fonction rateGarage
    match /garage_evaluations/{garageId} {
      allow read: if isSignedIn(); // Sécurisé : empêche le scraping anonyme (OWASP A01)
      allow delete: if isAdmin(); // modération
    }

    // Votes individuels (qui a noté quoi) : serveur uniquement
    match /garage_votes/{voteId} {
      allow read, write: if false;
    }

    // Roadbooks partagés (Community Roadbooks)
    match /community_roadbooks/{roadbookId} {
      allow read: if isSignedIn(); // Sécurisé : empêche le scraping anonyme (OWASP A01)
      allow create: if signedInOwnCreate();
      allow update, delete: if isAdmin() || (isSignedIn() && isOwner(resource.data.userId));
    }

    // Blocage d'IP (Banned IPs)
    match /banned_ips/{ip} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Logs de modération (Mod Logs)
    match /mod_logs/{logId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Recours & Demandes de réexamen de sanctions (Vérification humaine DSA Art. 20)
    match /mod_appeals/{appealId} {
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow read: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if false;
    }

    // ─────────────────────────────────────────────────────────────
    // REVOLUT — Collections de paiement
    // Écriture : Firebase Admin SDK (Cloud Functions) UNIQUEMENT
    // Lecture  : propriétaire du dossier uniquement
    // ─────────────────────────────────────────────────────────────

    // Ordres Revolut créés par la Cloud Function
    match /revolut_orders/{orderId} {
      allow read: if isSignedIn() && resource.data.user_id == request.auth.uid;
      allow write: if false; // Écriture exclusivement via Firebase Admin (Cloud Function)
    }

    // Confirmations de paiement (écrites par le webhook Revolut via Cloud Function)
    match /payment_confirmations/{caseId} {
      allow read: if isSignedIn() && resource.data.user_id == request.auth.uid;
      allow write: if false; // Écriture exclusivement via Firebase Admin (Cloud Function)
    }

    // Propositions de litige IA (Assureurs et Utilisateurs)
    match /litigation_proposals/{caseId} {
      // Données complètes du dossier (audit 2026-11) : le pilote, l'admin, ou l'assureur qui a PAYÉ
      // (ajouté dans unlocked_for par le serveur après confirmation Revolut). Connaître le numéro ne suffit plus.
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin()
                    || request.auth.uid in resource.data.get('unlocked_for', []));
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      
      // Le pilote crée son dossier, mais ne peut jamais se déclarer payé, débloqué ou scellé
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid
        && !request.resource.data.keys().hasAny(['report_unlocked', 'unlocked_for', 'unlocked_at', 'payment_status',
             'payment_method', 'revolut_order_id', 'paid_tier', 'paid_tiers', 'integrity_alert', 'evidence_sha256',
             'sealed_at', 'sealed_by', 'qualified_timestamp', 'free_timestamps']);
      // Autoriser l'admin à mettre à jour uniquement le statut (Zero Trust)
      allow update: if isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'resolvedBy', 'resolvedAt']);
    }

    // Aperçu d'un dossier de sinistre : ce que l'assureur voit AVANT de payer (aucune donnée de conduite)
    match /litigation_previews/{caseId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid
        && request.resource.data.caseCode == caseId
        && request.resource.data.keys().hasOnly(['caseCode', 'userId', 'createdAt', 'expiresAt',
             'recommendedReport', 'reportLabel', 'severityLabel', 'dateLabel']);
      allow update, delete: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────────
    // BLACK BOX SHOP (Matériel Physique)
    // ─────────────────────────────────────────────────────────────
    
    // Historique des commandes d'achat Black Box
    match /blackbox_sales/{orderId} {
      allow create: if false; // Écriture exclusivement via Cloud Function (Revolut Webhook / Admin SDK)
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow update, delete: if false; // Inaltérable
    }

    // Historique des recharges et achats de Points mon50cc
    match /points_transactions/{txId} {
      allow create: if false; // Écriture exclusivement via Cloud Function (Revolut Webhook / Admin SDK)
      allow read: if isAdmin() || (isSignedIn() && resource.data.user_id == request.auth.uid);
      allow update, delete: if false; // Inaltérable
    }

    // ─────────────────────────────────────────────────────────────
    // BLACK BOX REGISTRY (Unités physiques & Traçabilité Francelog S.A.)
    // ─────────────────────────────────────────────────────────────
    match /blackbox_units/{serial} {
      // Lecture réservée aux administrateurs ou au propriétaire du boîtier
      allow read: if isAdmin() || (isSignedIn() && resource.data.ownerUid == request.auth.uid);
      allow write: if false; // Écriture exclusive via Cloud Functions Admin SDK

      // Journal d'historique immuable de l'unité
      match /history/{histId} {
        allow read: if isAdmin();
        allow write: if false;
      }
    }

    // Compteurs et index de numérotation par révision (V1, etc.)
    match /blackbox_registry/{revision} {
      allow read: if isAdmin();
      allow write: if false; // Géré exclusivement par les transactions Cloud Functions
    }

    // Statistiques globales (compteurs publics : stock restant atelier, etc.)
    // NOTE DE SÉCURITÉ : Intentionnellement public — ne contient que des compteurs agrégés, aucune PII.
    match /stats/{statId} {
      allow read: if true; // Données agrégées publiques sans PII (OWASP ASVS v5.0.0-8.x)
      allow write: if false; // Uniquement via Firebase Admin SDK
    }

    // Garages Professionnels Certifiés
    // NOTE DE SÉCURITÉ : Intentionnellement public — annuaire B2C, aucune donnée sensible.
    match /garages/{garageId} {
      allow read: if isSignedIn(); // Sécurisé (Zero Trust)
      allow create: if isSignedIn() && isOwner(garageId); // Inscription par le garage
      allow update: if isOwner(garageId) || isAdmin(); // Mise à jour par le garage ou admin
      allow delete: if isAdmin();
    }

    // Cahier d'Entretien Digital — Règle déplacée en section unifiée (voir L428+)
    // (Doublon supprimé pour éviter les conflits de règles Firestore)

    // ─────────────────────────────────────────────────────────────
    // CREWS & TERRITORIES (Guerre de Territoire)
    // ─────────────────────────────────────────────────────────────

    match /crews/{crewId} {
      allow read: if isSignedIn(); // Sécurisé : empêche le scraping anonyme (OWASP A01)
      allow create: if signedInOwnCreate();
      // Le chef modifie tout ; un autre membre peut seulement rejoindre ou quitter (s'ajouter ou se retirer
      // de members), sans toucher au nom, aux points ni aux autres membres.
      allow update: if isSignedIn() && (isOwner(resource.data.leaderUid) || isAdmin() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
        && (request.resource.data.members.toSet() == resource.data.members.toSet().union([request.auth.uid].toSet())
            || request.resource.data.members.toSet() == resource.data.members.toSet().difference([request.auth.uid].toSet()))
      ));
      allow delete: if isAdmin();
    }

    // CREW CHATS (Messagerie privée des groupes)
    match /crew_chats/{crewId}/messages/{messageId} {
      allow read, create: if isSignedIn() && (request.auth.uid in get(/databases/$(database)/documents/crews/$(crewId)).data.members);
      allow update, delete: if false; // Messages inaltérables
    }

    match /territory_sectors/{sectorId} {
      allow read: if isSignedIn(); // Sécurisé : empêche le scraping anonyme
      // OWASP A01 : écriture restreinte au leader du crew propriétaire ou admin
      allow create: if isSignedIn() && isAdmin();
      allow update: if isSignedIn() && (
        isAdmin() ||
        (resource.data.ownerCrewId != null && get(/databases/$(database)/documents/crews/$(resource.data.ownerCrewId)).data.leaderUid == request.auth.uid)
      );
      allow delete: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────────
    // LOOT DROPS (Chasse au trésor)
    // ─────────────────────────────────────────────────────────────
    match /loot_drops/{lootId} {
      allow read: if isSignedIn();
      allow create: if isAdmin();
      // OWASP A01 : seul l'admin peut modifier un loot. Les utilisateurs ne peuvent que le "claim"
      // via une Cloud Function sécurisée qui valide la position GPS.
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────────
    // CORTÈGE SESSIONS (Balade Synchro)
    // ─────────────────────────────────────────────────────────────
    match /cortege_sessions/{sessionId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.leaderId;
      allow update: if isSignedIn() && (request.auth.uid == resource.data.leaderId || isAdmin());
      allow delete: if isSignedIn() && (request.auth.uid == resource.data.leaderId || isAdmin());
      
      match /members/{memberId} {
        allow read: if isSignedIn();
        // OWASP A01 : un membre ne peut écrire que sa propre entrée de position
        allow write: if isSignedIn() && request.auth.uid == memberId;
      }
    }

    // ─────────────────────────────────────────────────────────────
    // GARAGE TRADES (Troc de Pièces)
    // ─────────────────────────────────────────────────────────────
    match /garage_trades/{tradeId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.authorUid;
      allow update, delete: if isSignedIn() && request.auth.uid == resource.data.authorUid;
    }

    // ─────────────────────────────────────────────────────────────
    // S.O.S COMMUNAUTAIRE
    // ─────────────────────────────────────────────────────────────
    match /sos_alerts/{alertId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.authorUid;
      allow update: if isSignedIn() && request.auth.uid == resource.data.authorUid;
      
      match /helpers/{helperId} {
        allow read: if isSignedIn();
        // OWASP A01 : un helper ne peut écrire que sa propre entrée d'aide
        allow create: if isSignedIn() && request.auth.uid == helperId;
        allow update: if isSignedIn() && request.auth.uid == helperId;
        allow delete: if false; // Les traces d'aide sont conservées
      }
    }

    // ─────────────────────────────────────────────────────────────
    // ROADBOOKS (Tracés)
    // ─────────────────────────────────────────────────────────────
    match /roadbooks/{roadbookId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.authorUid;
      allow update, delete: if isSignedIn() && request.auth.uid == resource.data.authorUid;
    }

    // ─────────────────────────────────────────────────────────────
    // PIT STOPS (Stations et Garages)
    // ─────────────────────────────────────────────────────────────
    match /pit_stops/{pitstopId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.authorUid;
      allow update, delete: if isSignedIn() && request.auth.uid == resource.data.authorUid;
    }

    // ─────────────────────────────────────────────────────────────
    // MODE CONVOI (Balades en groupe)
    // ─────────────────────────────────────────────────────────────
    match /convoys/{convoyId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.leaderUid;
      allow update: if isSignedIn() && (request.auth.uid == resource.data.leaderUid || isAdmin());
      allow delete: if isSignedIn() && (request.auth.uid == resource.data.leaderUid || isAdmin());

      match /positions/{memberId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() && request.auth.uid == memberId;
      }
    }

    // ─────────────────────────────────────────────────────────────
    // BOURSE D'ÉCHANGE (Marketplace communautaire)
    // ─────────────────────────────────────────────────────────────
    match /exchange_listings/{listingId} {
      allow read: if isSignedIn(); // Sécurisé : empêche le scraping anonyme de la marketplace (OWASP A01)
      // Vendeur = auteur réel (avant : on pouvait publier une annonce au nom d'un autre membre)
      allow create: if isSignedIn()
        && request.resource.data.sellerUid == request.auth.uid
        && request.resource.data.seller == getUsername()
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 3
        && request.resource.data.title.size() <= 100
        && request.resource.data.price is number
        && request.resource.data.price > 0
        && request.resource.data.price <= 50000;
      allow update: if isSignedIn() && (
        resource.data.seller == getUsername() ||
        isAdmin()
      );
      allow delete: if isSignedIn() && (resource.data.seller == getUsername() || isAdmin());
    }

    // Messages entre acheteur et vendeur
    match /exchange_messages/{msgId} {
      allow read: if isSignedIn() && (
        resource.data.from == getUsername() ||
        resource.data.to == getUsername() ||
        resource.data.sender == getUsername() ||
        resource.data.receiver == getUsername() ||
        isAdmin()
      );
      allow create: if isSignedIn() && (
        request.resource.data.from == getUsername() ||
        request.resource.data.sender == getUsername()
      );
      allow update, delete: if false; // Messages immutables
    }

    // ─────────────────────────────────────────────────────────────
    // FIDO DEVICE ONBOARD (FDO) VOUCHERS
    // ─────────────────────────────────────────────────────────────
    match /fdo_vouchers/{voucherId} {
      // Les vouchers sont lus/écrits par les Cloud Functions ou l'admin
      allow read, write: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────────
    // GARAGE PARTNERS (Garages certifiés partenaires)
    // ─────────────────────────────────────────────────────────────
    match /garage_partners/{partnerId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isOwner(partnerId);
      allow update: if isOwner(partnerId) || isAdmin();
      allow delete: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────────
    // MAINTENANCE LOGS (Cahier d'entretien Cloud)
    // Entrées IMMUABLES : un entretien enregistré ne peut être
    // ni modifié ni supprimé (intégrité du cahier numérique).
    // Seul le propriétaire du véhicule peut lire ses entrées.
    // ─────────────────────────────────────────────────────────────
    match /maintenance_logs/{logId} {
      allow read: if isSignedIn() && (
        resource.data.vehicleOwnerUid == request.auth.uid ||
        resource.data.garageUid == request.auth.uid
      );
      allow create: if isSignedIn() && (
        // Cas 1 : Créé par un garage certifié
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isCertifiedGarage == true
         && request.resource.data.garageUid == request.auth.uid
         && request.resource.data.certified == true)
        ||
        // Cas 2 : Créé par le propriétaire du véhicule (non certifié)
        (request.resource.data.vehicleOwnerUid == request.auth.uid
         && request.resource.data.certified == false)
      )
      && request.resource.data.vehicleOwnerUid is string
      && request.resource.data.category is string
      && request.resource.data.description is string;
      allow update, delete: if false;
    }

    // ─────────────────────────────────────────────────────────────
    // FACEBOOK POSTS (Log des publications Page Facebook)
    // Écriture via Cloud Functions uniquement.
    // Lecture par les admins uniquement.
    // ─────────────────────────────────────────────────────────────
    match /facebook_posts/{postId} {
      allow read: if isAdmin();
      allow write: if false; // Écriture exclusivement via Firebase Admin (Cloud Function)
    }

    // ─────────────────────────────────────────────────────────────
    // SMS OUTBOX (Passerelle SMS Custom)
    // ─────────────────────────────────────────────────────────────
    match /sms_outbox/{msgId} {
      // Seul un admin ou la passerelle SMS (connectée en Admin) peut lire/écrire
      allow read, write: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────────
    // TELEMETRY SESSIONS (Métadonnées de sessions de télémétrie Cloud Storage)
    // ─────────────────────────────────────────────────────────────
    match /telemetry_sessions/{sessionId} {
      // Lecture autorisée uniquement par le propriétaire ou l'admin
      allow read: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      // Écriture réservée exclusivement au backend Cloud Functions (Admin SDK)
      allow write: if false;
    }

    // ─────────────────────────────────────────────────────────────
    // FIDO2 CHALLENGES (Éphémères — C-3 FIX)
    // Gérés exclusivement par les Cloud Functions (Admin SDK).
    // Aucun accès client autorisé (OWASP ASVS v5.0.0-8.x).
    // ─────────────────────────────────────────────────────────────
    match /fido_challenges/{uid} {
      allow read, write: if false;
    }

    // ─────────────────────────────────────────────────────────────
    // RATE LIMITS (Anti-abus — C-3 FIX)
    // Gérés exclusivement par les Cloud Functions (Admin SDK).
    // ─────────────────────────────────────────────────────────────
    match /rate_limits/{limitId} {
      allow read, write: if false;
    }

    // ─────────────────────────────────────────────────────────────
    // THEFT ALERTS (Alertes vol — C-3 FIX)
    // Écriture via Cloud Functions uniquement.
    // Lecture par le propriétaire ou l'admin.
    // ─────────────────────────────────────────────────────────────
    match /theft_alerts/{alertId} {
      allow read: if isSignedIn() && (resource.data.user_id == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // ─────────────────────────────────────────────────────────────
    // FACEBOOK DAILY RUNS (Idempotence & Verrouillage CRON — ISO 27001 A.5.15)
    // Lecture par les admins uniquement. Écriture réservée au backend Cloud Function.
    // ─────────────────────────────────────────────────────────────
    match /facebook_daily_runs/{dateKey} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ─────────────────────────────────────────────────────────────
    // SYSTEM CONFIGURATION (Coupe-circuit & Paramètres globaux — ISO 27001 A.8.31)
    // Lecture et écriture réservées strictement aux administrateurs.
    // ─────────────────────────────────────────────────────────────
    match /config/{configId} {
      allow read, write: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────────
    // AUTH LOGS (Télémétrie d'Authentification Anonymisée & Audit)
    // Conforme NIST CSF 2.0 DE.AE-08 & OWASP ASVS v5.0.0-16.x
    // ─────────────────────────────────────────────────────────────
    match /auth_logs/{logId} {
      allow create: if request.resource.data.keys().hasOnly(['uid_hash', 'method', 'status', 'errorCode', 'timestamp'])
        && request.resource.data.method in ['password', 'google', 'fido2']
        && request.resource.data.status in ['success', 'failure']
        && (request.resource.data.errorCode is string || request.resource.data.errorCode == null)
        && request.resource.data.timestamp == request.time;
      allow read: if isAdmin();
      allow update, delete: if false; // Immuabilité absolue des logs d'audit
    }

    // ─────────────────────────────────────────────────────────────
    // NEXUS CONVERSATIONS (Synchronisation d'interactions & Feedback)
    // Lecture réservée aux administrateurs. Écriture réservée aux utilisateurs connectés.
    // ─────────────────────────────────────────────────────────────
    match /nexus_conversations/{sessionId} {
      // Chacun n'écrit que dans ses propres conversations (avant : n'importe qui pouvait modifier celles des autres)
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if isSignedIn() && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow read, delete: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────────
    // NEXUS SUGGESTIONS (Détection sémantique d'idées & feedback)
    // ─────────────────────────────────────────────────────────────
    match /nexus_suggestions/{suggestionId} {
      allow create: if isSignedIn(); // uid peut valoir "anonymous" (nexus-semantic-analyzer.js)
      allow read, update, delete: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────────
    // NEXUS IMPROVEMENT REPORTS (Rapports d'architecture autonome)
    // Générés par les Cloud Functions (Admin SDK). Lecture admin uniquement.
    // ─────────────────────────────────────────────────────────────
    match /nexus_improvement_reports/{reportId} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
