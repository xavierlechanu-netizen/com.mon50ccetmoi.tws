# ============================================================================
# Modèle du fichier sovereign-core/.env pour le VPS.
# deploy/install.sh le copie en .env et remplit lui-même les secrets marqués (auto).
# Le fichier .env ne doit JAMAIS être ajouté à git (il est dans .gitignore).
# ============================================================================

# --- Domaine de l'API (enregistrement DNS A vers l'IP du VPS) ---
API_DOMAIN=api.mon50ccetmoi.com
ACME_EMAIL=contact@mon50ccetmoi.com
CORS_ORIGIN=https://mon50ccetmoi.com

# --- Le site (jour J, deploy/README.md étape 10) ---
# À laisser VIDES tant que le DNS de mon50ccetmoi.com pointe encore vers l'ancien hébergement :
# le site est alors servi seulement à l'intérieur du VPS, pour vérification.
SITE_DOMAIN=
SITE_WWW_DOMAIN=
# Dossier des versions publiées par deploy/publish-site.sh
SITE_ROOT=/srv/mon50cc/site

# --- Comptes importés de Firebase (jour J, deploy/README.md étape 11) ---
# Console Firebase > Authentication > Users > ⋮ > « Password hash parameters ».
# Recopier base64_signer_key, base64_salt_separator, rounds et mem_cost tels quels.
FIREBASE_SCRYPT_SIGNER_KEY=
FIREBASE_SCRYPT_SALT_SEPARATOR=
FIREBASE_SCRYPT_ROUNDS=8
FIREBASE_SCRYPT_MEM_COST=14

# --- Base PostgreSQL ---
DB_USER=mon50cc_admin
DB_PASSWORD=                     # (auto)

# --- Clés de signature des connexions (JWT ES256) ---
SOVEREIGN_JWT_PRIVATE_KEY=       # (auto)
SOVEREIGN_JWT_PUBLIC_KEY=        # (auto)

# --- Paiements Revolut (facultatif au début) ---
REVOLUT_WEBHOOK_SECRET=

# --- Coffre des preuves : Object Storage OVHcloud, bucket créé AVEC Object Lock ---
# Utilisateur S3 dédié : droit d'écrire et de lire, rien d'autre.
WORM_S3_BUCKET=mon50cc-preuves
WORM_S3_ENDPOINT=https://s3.gra.io.cloud.ovh.net
WORM_S3_REGION=gra
WORM_S3_ACCESS_KEY_ID=
WORM_S3_SECRET_ACCESS_KEY=
WORM_RETENTION_DAYS=1826

# --- SMS de l'alerte SOS (OVHcloud SMS), voir deploy/README.md « SMS d'urgence » ---
# Clé d'API limitée à POST /sms/<service>/jobs. Vides : pas d'envoi (l'appli le dit et propose le 112).
OVH_SMS_APP_KEY=
OVH_SMS_APP_SECRET=
OVH_SMS_CONSUMER_KEY=
OVH_SMS_SERVICE=
# Nom d'expéditeur validé chez OVHcloud (demandé le 16/11/2026 : Mon50cc) ; vide : envoi depuis un numéro court.
OVH_SMS_SENDER=
# Budget de SMS sur 24 h pour tout le serveur (garde-fou contre un abus) ; 300 si vide.
# Chaque pilote reste en plus limité à 3 alertes par 10 minutes et 10 par 24 h.
SOS_DAILY_SMS_BUDGET=300

# --- Vigilance Météo-France (bandeau « vigilance rouge »), voir deploy/README.md étape 9 bis ---
# Clé d'API créée par vous sur portail-api.meteofrance.fr (API « Données Publiques Vigilance »),
# collée ici directement, jamais ailleurs. Vide : le serveur démarre, l'appli n'affiche pas d'alerte.
METEO_FRANCE_API_KEY=

# --- Sauvegardes de la base : un AUTRE bucket, SANS Object Lock ---
# Utilisateur S3 dédié, différent de celui des preuves (il doit pouvoir supprimer les vieilles sauvegardes).
BACKUP_S3_BUCKET=mon50cc-sauvegardes
BACKUP_S3_ENDPOINT=https://s3.gra.io.cloud.ovh.net
BACKUP_S3_REGION=gra
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_RETENTION_DAYS=30
# Phrase de chiffrement des sauvegardes. (auto)
# À RECOPIER dans un gestionnaire de mots de passe : sans elle, les sauvegardes sont illisibles.
BACKUP_PASSPHRASE=
