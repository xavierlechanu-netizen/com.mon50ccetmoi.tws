{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs22"
  },
  "hosting": {
    "public": "dist",
    "cleanUrls": true,
    "trailingSlash": false,
    "headers": [
      {
        "source": "/.well-known/assetlinks.json",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Content-Type",
            "value": "text/html; charset=utf-8"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-Frame-Options",
            "value": "SAMEORIGIN"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Strict-Transport-Security",
            "value": "max-age=63072000; includeSubDomains; preload"
          },
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://www.gstatic.com https://apis.google.com https://maps.googleapis.com https://unpkg.com https://cdnjs.cloudflare.com https://translate.googleapis.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com https://unpkg.com https://translate.googleapis.com; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: blob: https://*.googleapis.com https://*.gstatic.com https://*.tile.openstreetmap.org; connect-src 'self' https://*.googleapis.com https://*.firebaseio.com https://*.cloudfunctions.net wss://*.firebaseio.com https://merchant.revolut.com https://cdn.revolut.com https://api.piste.gouv.fr https://oauth.piste.gouv.fr; frame-src 'self' https://merchant.revolut.com https://cdn.revolut.com https://translate.google.com; object-src 'none'; base-uri 'self'"
          },
          {
            "key": "Permissions-Policy",
            "value": "geolocation=(self), camera=(), microphone=(self), accelerometer=(self), gyroscope=(self)"
          }
        ]
      },
      {
        "source": "**/*.js",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/javascript; charset=utf-8"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          }
        ]
      }
    ],
    "ignore": [
      "firebase.json",
      "functions/**",
      "node_modules/**",
      "_legacy/**",
      "docs/**",
      "scratch/**",
      "scripts/**",
      "tools/**",
      "templates/**",
      "android-app/**",
      "assets_ui_bak/**",
      "*.jks",
      "*.gradle",
      "*.bat",
      "*.py",
      "*.bak",
      "*.zip",
      "*.odt",
      "*.aab",
      "*.apk",
      "*.idsig",
      "*.pem",
      "*.txt",
      "*.md",
      "README.md",
      "CHANGELOG.md",
      "MANIFESTO.md",
      "service-account.json",
      "mon50ccetmoi-firebase-adminsdk-*.json",
      "local.properties",
      "gradle*",
      "settings.gradle",
      "build.gradle",
      "twa-manifest.json",
      ".github/**",
      ".gradle/**",
      ".firebase/**"
    ]
  }
}
